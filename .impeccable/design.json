  "narrative": {
    "northStar": "Herdr's quota instrument panel",
    "overview": "The installed Herdr theme is the visual authority. This native GPUI mod follows the compact status-bar-to-dashboard workflow of Lakris2407/herdr-quota, with graphical instruments for quota pressure. It adds health colors and gauge geometry without introducing a separate web identity.\n\nThe strip is dense and quiet; the dashboard provides provider limits and session activity in a scrollable native window. Account quota and session activity remain visually distinct. This record comes from `mods/agent-quota/main.js` and `core.js`, with product constraints from `PRODUCT.md`. It is a source-derived system, not evidence of native visual verification. A native trial remains pending.",
    "keyCharacteristics": [
      "Native theme inheritance for surfaces, text, focus and agent activity.",
      "A compact strip opens a detailed quota dashboard.",
      "A clockwise 240\u00b0 gauge makes remaining headroom visible.",
      "Unknown, stale and remote information retain explicit labels."
    ],
    "rules": [
      {
        "name": "The Theme Inheritance Rule",
        "body": "Resolve native surface, text, interaction and activity roles from Herdr on render. The fixed colors in `scripts/preview.mjs` are sample preview values, not the installed theme or native design tokens.",
        "section": "colors"
      },
      {
        "name": "The Honest Reading Rule",
        "body": "Only fresh account quota contributes to redline alerts. Unknown usage is never rendered as a measured zero; stale usage never carries fresh health color.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** inherit Herdr's theme and font at render time.",
      "**Do** keep the strip compact and reveal detailed gauges in the dashboard.",
      "**Do** preserve the 240\u00b0 gauge geometry and configurable redline, defaulting to 70% used.",
      "**Do** accompany color with percentages, status words and explicit unknown/stale labels.",
      "**Do** keep provider account quota separate from session and remote activity.",
      "**Do** preserve focus borders and keyboard activation on native controls."
    ],
    "donts": [
      "**Don't** promote the browser preview palette, system font, frame or substitute glyphs into native tokens.",
      "**Don't** invent percentages, reset times, quota windows or token counts.",
      "**Don't** sum account quota across spaces or infer a session's account from its provider.",
      "**Don't** describe source extraction or synthetic browser approximations as native visual verification."
    ]
  }
}
